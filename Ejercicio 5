public class Ejercicio05_SobrecargaPromedio {
    public static double calcularPromedio(double nota1, double nota2) {
        return (nota1 + nota2) / 2;
    }

    public static double calcularPromedio(double[] notas) {
        double suma = 0;
        for (double n : notas) suma += n;
        return suma / notas.length;
    }

    public static void main(String[] args) {
        System.out.println("Promedio 2 notas: " + calcularPromedio(4.5, 3.8));
        double[] grupo = {3.0, 4.0, 5.0};
        System.out.println("Promedio arreglo: " + calcularPromedio(grupo));
    }
}
